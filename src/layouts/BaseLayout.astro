---
import '../styles/global.css';
import { SITE, OG_IMAGE, ACQUISITION_MAILTO } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const publishedDate = '2026-06-08';
const faqQuestions = [
  {
    question: 'Is the price negotiable?',
    answer:
      'The listed price of $195,000 reflects the domain’s premium .com positioning, instant brand relevance, strong market timing in the AI creative space, and the added value of the world’s most trusted extension. Reasonable offers from serious, qualified buyers will be considered.',
  },
  {
    question: 'How does the transfer process work?',
    answer:
      'We use reputable escrow services such as Escrow.com or Dan.com. You pay into escrow, we initiate the domain transfer via the registrar, and funds are released only after successful transfer and confirmation. Full guidance is provided.',
  },
  {
    question: 'Why .com instead of a newer TLD?',
    answer:
      '.com remains the gold standard for trust, professionalism, email infrastructure, and global recognition. eDesigrs.com delivers timeless brand equity and maximum credibility with clients, investors, and partners.',
  },
  {
    question: 'Can I use this for my personal brand or portfolio?',
    answer:
      'Absolutely. eDesigrs.com gives artists, designers, and creative technologists a memorable, professional home for their work.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description,
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}/#webpage`,
      url: SITE.url,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      datePublished: publishedDate,
      dateModified: publishedDate,
      inLanguage: 'en-US',
    },
    {
      '@type': 'Product',
      '@id': `${SITE.url}/#product`,
      name: 'eDesigrs.com Premium Domain Name',
      description:
        'The definitive premium domain for electronic designers, generative artists, AI art platforms, and creative studios. Available for acquisition.',
      url: SITE.url,
      category: 'Premium Domain Name',
      brand: {
        '@type': 'Brand',
        name: 'eDesigrs.com',
      },
      offers: {
        '@type': 'Offer',
        url: ACQUISITION_MAILTO,
        price: '195000',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        priceValidUntil: '2027-06-08',
        seller: {
          '@type': 'Organization',
          name: SITE.name,
          email: SITE.email,
        },
      },
      audience: {
        '@type': 'Audience',
        audienceType: 'Electronic designers, AI creatives, and digital studios',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/#faq`,
      mainEntity: faqQuestions.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: answer,
        },
      })),
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Phoenix',
        addressRegion: 'AZ',
        addressCountry: 'US',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#09090b" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="eDesigrs.com — Premium Domain for Electronic Designers & AI Creatives" />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="eDesigrs.com — Premium Domain for Electronic Designers & AI Creatives" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" /></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
